generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  importFileExtension = "js"
}

datasource db {
  provider = "sqlite"
}

model Merchant {
  id           String        @id @default(cuid())
  businessName String
  email        String        @unique
  passwordHash String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  apiKeys      ApiKey[]
  transactions Transaction[]
}

enum ApiKeyKind {
  PUBLIC
  SECRET
}

model ApiKey {
  id         String     @id @default(cuid())
  merchantId String
  merchant   Merchant   @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  kind       ApiKeyKind
  keyHash    String     @unique
  prefix     String
  createdAt  DateTime   @default(now())
  revokedAt  DateTime?

  @@index([merchantId])
}

enum TransactionStatus {
  PENDING
  AWAITING_OTP
  SUCCESSFUL
  FAILED
  ABANDONED
}

model Transaction {
  id            String            @id @default(cuid())
  merchantId    String
  merchant      Merchant          @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  txRef         String
  amountKobo    Int
  currency      String
  status        TransactionStatus @default(PENDING)
  customerEmail String
  cardLast4     String?
  redirectUrl   String
  expiresAt     DateTime
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([merchantId, txRef])
  @@index([merchantId, createdAt])
}
