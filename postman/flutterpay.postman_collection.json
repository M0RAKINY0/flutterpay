{
  "info": {
    "_postman_id": "7f3a2c81-5c9b-4a34-9c42-flutterpay0001",
    "name": "FlutterPay API",
    "description": "Local API test collection for FlutterPay (Phases 0-2): health, merchant signup, secret-key authentication, payment creation, duplicate tx_ref check, and paginated daily/weekly/monthly transaction history.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:3000" },
    { "key": "merchant_email", "value": "" },
    { "key": "merchant_password", "value": "a-long-learning-password" },
    { "key": "public_key", "value": "" },
    { "key": "secret_key", "value": "" },
    { "key": "tx_ref", "value": "" },
    { "key": "transaction_id", "value": "" },
    { "key": "checkout_link", "value": "" }
  ],
  "item": [
    {
      "name": "1. Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health",
          "host": ["{{base_url}}"],
          "path": ["health"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Health returns 200 OK', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().ok).to.eql(true);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Register Merchant",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"business_name\": \"Ada's business\",\n  \"email\": \"{{merchant_email}}\",\n  \"password\": \"{{merchant_password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/v1/merchants",
          "host": ["{{base_url}}"],
          "path": ["v1", "merchants"]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const suffix = Date.now() + '-' + Math.floor(Math.random() * 100000);",
              "pm.collectionVariables.set('merchant_email', 'merchant-' + suffix + '@example.com');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Merchant signup returns 201 and API keys', function () {",
              "  pm.response.to.have.status(201);",
              "  const data = pm.response.json();",
              "  pm.expect(data.keys.public_key).to.match(/^fp_pub_test_[a-f0-9]{64}$/);",
              "  pm.expect(data.keys.secret_key).to.match(/^fp_sec_test_[a-f0-9]{64}$/);",
              "  pm.collectionVariables.set('public_key', data.keys.public_key);",
              "  pm.collectionVariables.set('secret_key', data.keys.secret_key);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Get Authenticated Merchant",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{secret_key}}" }
        ],
        "url": {
          "raw": "{{base_url}}/v1/merchants/me",
          "host": ["{{base_url}}"],
          "path": ["v1", "merchants", "me"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Secret key authenticates merchant', function () {",
              "  pm.response.to.have.status(200);",
              "  const data = pm.response.json();",
              "  pm.expect(data.merchant.email).to.eql(pm.collectionVariables.get('merchant_email'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Reject Public Key on Protected Route",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{public_key}}" }
        ],
        "url": {
          "raw": "{{base_url}}/v1/merchants/me",
          "host": ["{{base_url}}"],
          "path": ["v1", "merchants", "me"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Public key is rejected with 401 UNAUTHORIZED', function () {",
              "  pm.response.to.have.status(401);",
              "  pm.expect(pm.response.json().error.code).to.eql('UNAUTHORIZED');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Create Payment",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{secret_key}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tx_ref\": \"{{tx_ref}}\",\n  \"amount_kobo\": 500000,\n  \"currency\": \"NGN\",\n  \"customer_email\": \"buyer@example.com\",\n  \"redirect_url\": \"http://127.0.0.1:4000/callback\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/v1/payments",
          "host": ["{{base_url}}"],
          "path": ["v1", "payments"]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const suffix = Date.now() + '-' + Math.floor(Math.random() * 100000);",
              "pm.collectionVariables.set('tx_ref', 'order-' + suffix);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Payment creation returns 201, pending status and checkout link', function () {",
              "  pm.response.to.have.status(201);",
              "  const data = pm.response.json();",
              "  pm.expect(data.transaction.status).to.eql('pending');",
              "  pm.expect(data.transaction.amount_kobo).to.eql(500000);",
              "  pm.expect(data.transaction.currency).to.eql('NGN');",
              "  pm.expect(data.link).to.include('/pay/' + data.transaction.id);",
              "  pm.collectionVariables.set('transaction_id', data.transaction.id);",
              "  pm.collectionVariables.set('checkout_link', data.link);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Reject Duplicate tx_ref",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{secret_key}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tx_ref\": \"{{tx_ref}}\",\n  \"amount_kobo\": 500000,\n  \"currency\": \"NGN\",\n  \"customer_email\": \"buyer@example.com\",\n  \"redirect_url\": \"http://127.0.0.1:4000/callback\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/v1/payments",
          "host": ["{{base_url}}"],
          "path": ["v1", "payments"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Duplicate tx_ref returns 409 DUPLICATE_TX_REF', function () {",
              "  pm.response.to.have.status(409);",
              "  pm.expect(pm.response.json().error.code).to.eql('DUPLICATE_TX_REF');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "7. List Transactions (All, Paginated)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{secret_key}}" }
        ],
        "url": {
          "raw": "{{base_url}}/v1/transactions?page=1&limit=10",
          "host": ["{{base_url}}"],
          "path": ["v1", "transactions"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "10" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('All transaction history returns created payment', function () {",
              "  pm.response.to.have.status(200);",
              "  const data = pm.response.json();",
              "  pm.expect(data.period.type).to.eql('all');",
              "  pm.expect(data.pagination.total).to.be.at.least(1);",
              "  pm.expect(data.transactions[0].tx_ref).to.eql(pm.collectionVariables.get('tx_ref'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "8. List Transactions (Daily)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{secret_key}}" }
        ],
        "url": {
          "raw": "{{base_url}}/v1/transactions?period=daily&page=1&limit=10",
          "host": ["{{base_url}}"],
          "path": ["v1", "transactions"],
          "query": [
            { "key": "period", "value": "daily" },
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "10" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Daily transaction history includes today payment', function () {",
              "  pm.response.to.have.status(200);",
              "  const data = pm.response.json();",
              "  pm.expect(data.period.type).to.eql('daily');",
              "  pm.expect(data.transactions[0].tx_ref).to.eql(pm.collectionVariables.get('tx_ref'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "9. List Transactions (Weekly)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{secret_key}}" }
        ],
        "url": {
          "raw": "{{base_url}}/v1/transactions?period=weekly&page=1&limit=10",
          "host": ["{{base_url}}"],
          "path": ["v1", "transactions"],
          "query": [
            { "key": "period", "value": "weekly" },
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "10" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Weekly transaction history includes this week payment', function () {",
              "  pm.response.to.have.status(200);",
              "  const data = pm.response.json();",
              "  pm.expect(data.period.type).to.eql('weekly');",
              "  pm.expect(data.transactions[0].tx_ref).to.eql(pm.collectionVariables.get('tx_ref'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "10. List Transactions (Monthly)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{secret_key}}" }
        ],
        "url": {
          "raw": "{{base_url}}/v1/transactions?period=monthly&page=1&limit=10",
          "host": ["{{base_url}}"],
          "path": ["v1", "transactions"],
          "query": [
            { "key": "period", "value": "monthly" },
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "10" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Monthly transaction history includes this month payment', function () {",
              "  pm.response.to.have.status(200);",
              "  const data = pm.response.json();",
              "  pm.expect(data.period.type).to.eql('monthly');",
              "  pm.expect(data.transactions[0].tx_ref).to.eql(pm.collectionVariables.get('tx_ref'));",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
