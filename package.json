{
  "name": "flutterpay",
  "version": "0.1.0",
  "private": true,
  "description": "A simulated payment gateway for learning backend development.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.20.0 <23"
  },
  "overrides": {
    "@prisma/config": {
      "effect": "3.22.5"
    }
  },
  "scripts": {
    "dev": "npm run dev --workspace=@flutterpay/api",
    "build": "npm run build --workspace=@flutterpay/api",
    "start": "npm run start --workspace=@flutterpay/api",
    "typecheck": "npm run typecheck --workspace=@flutterpay/api",
    "test": "npm run test --workspace=@flutterpay/api",
    "db:generate": "npm run db:generate --workspace=@flutterpay/api",
    "db:migrate": "npm run db:migrate --workspace=@flutterpay/api --",
    "db:deploy": "npm run db:deploy --workspace=@flutterpay/api",
    "db:studio": "npm run db:studio --workspace=@flutterpay/api",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7"
  }
}
